@model IntelliCasePro.Web.Controllers.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | IntelliCase Pro</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login-shell">
        <section class="login-panel login-brand-panel">
            <div class="login-brand-header">
                <div class="login-brand-text">
                    <div class="login-brand-name">IntelliCase Pro</div>
                    <div class="eyebrow light">Secure investigator access</div>
                </div>
                <div class="login-brand-mark">◎</div>
            </div>

            <div class="login-brand-content">
                <div class="login-brand-main">
                    <p class="login-copy">
                        Case intelligence, evidence tracking, billing, and field operations.
                    </p>

                    <div class="login-feature-list">
                        <div class="login-feature-pill">Case command</div>
                        <div class="login-feature-pill">Evidence tracking</div>
                        <div class="login-feature-pill">Billing and reporting</div>
                    </div>

                    <div class="login-stat-grid">
                        <div class="login-stat-card">
                            <strong>Role-based access</strong>
                            <span>Admins, investigators, and analysts— each user sees the tools and information that fit their role.</span>
                        </div>

                        <div class="login-stat-card">
                            <strong>Field-ready workflow</strong>
                            <span>Everything tied to a case, from tasks to expenses to evidence, stays together in one file.</span>
                        </div>

                        <div class="login-stat-card">
                            <strong>Audit-aware structure</strong>
                            <span>Built to keep information clear, organized, and easy to track.</span>
                        </div>
                    </div>
                </div>

                <div class="login-credential-card">
                    <div class="credential-title">Demo accounts</div>

                    <div class="credential-row">
                        <div>
                            <strong>Admin</strong>
                            <div class="subtle light">jane@intellicasepro.local</div>
                        </div>
                        <code>Demo#2026!</code>
                    </div>

                    <div class="credential-row">
                        <div>
                            <strong>Investigator</strong>
                            <div class="subtle light">marcus@intellicasepro.local</div>
                        </div>
                        <code>Demo#2026!</code>
                    </div>

                    <div class="credential-row">
                        <div>
                            <strong>Analyst</strong>
                            <div class="subtle light">priya@intellicasepro.local</div>
                        </div>
                        <code>Demo#2026!</code>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-panel login-form-panel">
            <div>
                <div class="eyebrow">Authentication</div>
                <h2 class="login-title">Sign in to continue</h2>
                <p class="subtle">Use one of the seeded investigator accounts or wire your own into the database later.</p>
            </div>

            <form method="post" asp-action="Login" class="login-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div>
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="username" />
                    <span asp-validation-for="Email" class="field-validation"></span>
                </div>

                <div>
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <label class="checkbox-line remember-line">
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in on this device</span>
                </label>

                <button type="submit" class="button dark login-submit">Sign In</button>
            </form>
        </section>
    </main>
</body>
</html>
