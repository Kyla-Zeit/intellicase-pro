@model List<Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="card">
    <div class="card-head">
        <h2>Client Directory</h2>
        <a class="button" asp-action="Create">Add Client</a>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Cases</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
                    <td>@item.CompanyName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Cases.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
